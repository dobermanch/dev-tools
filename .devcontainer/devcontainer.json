{
  "name": "dev-tools",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "runArgs": [
    "--name",
    "dev-tools"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker": {
      "version": "latest",
      "mounts": [
        "/var/run/docker.sock:/var/run/docker.sock"
      ]
    },
    "./idle-shutdown": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-containers",
        "ms-vscode.makefile-tools",
        "editorconfig.editorconfig",
        "streetsidesoftware.code-spell-checker",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "davidanson.vscode-markdownlint",
        "humao.rest-client",
        "anthropic.claude-code"
      ]
    }
  },
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    },
    "source=${localEnv:USERPROFILE}${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
    "source=${localEnv:USERPROFILE}${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind"
  ],
  "onCreateCommand": "bash .devcontainer/init.sh",
  // Stop on last window close; ./idle-shutdown stops it after 30 idle minutes
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode"
}
{
  "name": "dev-tools",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "runArgs": [
    "--name",
    "dev-tools"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker": {
      "version": "latest",
      "mounts": [
        "/var/run/docker.sock:/var/run/docker.sock"
      ]
    },
    "ghcr.io/dobermanch/devcontainer-features/vscode-base:1": {},
    "ghcr.io/dobermanch/devcontainer-features/host-ssh:1": {},
    "ghcr.io/dobermanch/devcontainer-features/host-claude:1": {},
    "ghcr.io/dobermanch/devcontainer-features/idle-shutdown:1": {}
  },
  "customizations": {
    "vscode": {
      // Added to vscode-base's list
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-containers",
        "ms-vscode.makefile-tools",
        "davidanson.vscode-markdownlint",
        "humao.rest-client"
      ]
    }
  },
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],
  "onCreateCommand": "bash .devcontainer/init.sh",
  // Stop on last window close; idle-shutdown stops it after 30 idle minutes
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode"
}
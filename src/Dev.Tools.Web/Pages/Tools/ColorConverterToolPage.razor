@page "/tools/color-converter"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtTextField
        T="string"
        Label="@_localizer["TextField.Color.Label"]"
        @bind-Value="@_color"
        OnDebounceIntervalElapsed="@OnColorChangedAsync"
        Error="@(ColorError is not null)"
        ErrorText="@ColorError"
        ShowCopyButton="false"/>

    <DtColorPicker
        Label="@_localizer["ColorPicker.Label"]"
        Value="@_picked"
        ValueChanged="@OnPickedAsync"
        ShowAlpha="true"/>
</DtOptions>

<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Hex.Label"]"
        Text="@AllFormats"
        DownloadFileName="color-converter.txt"
        Status="@ColorError"
        StatusIsError="@(ColorError is not null)">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                @* The colour itself, which no amount of notation conveys. *@
                <div class="dt-color-swatch" style="background: @_result.Rgb"></div>

                <DtFieldValue Label="@_localizer["TextField.Hex.Label"]" Value="@_result.Hex"/>
                <DtFieldValue Label="@_localizer["TextField.Rgb.Label"]" Value="@_result.Rgb"/>
                <DtFieldValue Label="@_localizer["TextField.Hsl.Label"]" Value="@_result.Hsl"/>
                <DtFieldValue Label="@_localizer["TextField.Hwb.Label"]" Value="@_result.Hwb"/>
                <DtFieldValue Label="@_localizer["TextField.Cmyk.Label"]" Value="@_result.Cmyk"/>

                @if (_result.Name is not null)
                {
                    <DtFieldValue Label="@_localizer["TextField.Name.Label"]" Value="@_result.Name"/>
                }
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

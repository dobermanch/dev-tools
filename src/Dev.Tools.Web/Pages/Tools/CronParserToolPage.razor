@page "/tools/cron-parser"
@using System.Globalization

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<MudCard Class="my-4">
    <MudCardContent>
        <DtSection Id="input" Class="mt-0">
            <MudGrid Class="align-center" Spacing="4">
                <MudItem xs="12" md="6">
                    <DtTextField
                        T="string"
                        Label="@_localizer["TextField.Expression.Label"]"
                        @bind-Value="@_expression"
                        OnDebounceIntervalElapsed="@OnValueChangedAsync"
                        Error="@(ExpressionError is not null)"
                        ErrorText="@ExpressionError"
                        LabelPosition="LabelPositionType.Inline"
                    />
                </MudItem>
                <MudItem xs="12" md="6">
                    <DtTextField
                        T="string"
                        Label="@_localizer["TextField.TimeZone.Label"]"
                        @bind-Value="@_timeZone"
                        OnDebounceIntervalElapsed="@OnValueChangedAsync"
                        Error="@(TimeZoneError is not null)"
                        ErrorText="@TimeZoneError"
                        LabelPosition="LabelPositionType.Inline"
                    />
                </MudItem>
                <MudItem xs="12" md="6">
                    <DtSlider
                        T="int"
                        Label="@_localizer["Slider.Count.Label"]"
                        Value="@_count"
                        MinValue="1"
                        MaxValue="100"
                        ValueChanged="OnCountChangedAsync"/>
                </MudItem>
            </MudGrid>
        </DtSection>

        @if (_result is { HasErrors: false })
        {
            <DtSection Id="output" ShowDivider="true">
                <MudGrid Class="align-center" Spacing="4">
                    <MudItem xs="12">
                        <DtTextField
                            T="string"
                            Value="@_result.Description"
                            Label="@_localizer["TextField.Description.Label"]"
                            ReadOnly="true"
                            LabelPosition="LabelPositionType.Inline"/>
                    </MudItem>
                    <MudItem xs="12">
                        @if (_result.NextRuns.Count > 0)
                        {
                            <MudTable Items="@_result.NextRuns" Elevation="0" Dense="true" Hover="true" Bordered="true"
                                      Striped="false" Height="600" HorizontalScrollbar="true">
                                <HeaderContent>
                                    <MudTh>@_localizer["Table.Header.Time"]</MudTh>
                                    <MudTh>@_localizer["Table.Header.DayOfWeek"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.ToString("yyyy-MM-dd HH:mm:ss zzz", CultureInfo.InvariantCulture)</MudTd>
                                    <MudTd>@context.ToString("dddd", CultureInfo.CurrentUICulture)</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudText>@_localizer["Text.NoRuns"]</MudText>
                        }
                    </MudItem>
                </MudGrid>
            </DtSection>
        }
    </MudCardContent>
</MudCard>

@page "/tools/ip-subnet"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

@* A CIDR block is one line. *@
<DtOptions>
    <DtTextField
        T="string"
        Class="dt-span-2"
        Label="@_localizer["TextField.Input.Label"]"
        @bind-Value="@_input"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"
        Error="@(InputError is not null)"
        ErrorText="@InputError"/>
</DtOptions>

<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Input.Label"]"
        Text="@AllValues"
        DownloadFileName="ip-subnet.txt"
        Status="@InputError"
        StatusIsError="@(InputError is not null)">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                <DtFieldValue Label="@_localizer["TextField.Network.Label"]" Value="@_result.Network"/>
                <DtFieldValue Label="@_localizer["TextField.NetworkAddress.Label"]" Value="@_result.NetworkAddress"/>
                <DtFieldValue Label="@_localizer["TextField.SubnetMask.Label"]" Value="@_result.SubnetMask"/>
                <DtFieldValue Label="@_localizer["TextField.PrefixLength.Label"]" Value="@($"/{_result.PrefixLength}")"/>
                <DtFieldValue Label="@_localizer["TextField.WildcardMask.Label"]" Value="@_result.WildcardMask"/>
                <DtFieldValue Label="@_localizer["TextField.AddressCount.Label"]" Value="@_result.AddressCount"/>
                <DtFieldValue Label="@_localizer["TextField.FirstHost.Label"]" Value="@_result.FirstHost"/>
                <DtFieldValue Label="@_localizer["TextField.LastHost.Label"]" Value="@_result.LastHost"/>
                <DtFieldValue Label="@_localizer["TextField.HostCount.Label"]" Value="@_result.HostCount"/>

                @if (_result.BroadcastAddress is not null)
                {
                    <DtFieldValue Label="@_localizer["TextField.BroadcastAddress.Label"]" Value="@_result.BroadcastAddress"/>
                }
                @if (_result.IpClass is not null)
                {
                    <DtFieldValue Label="@_localizer["TextField.IpClass.Label"]" Value="@_result.IpClass"/>
                }
                @if (_result.Blocks.Count > 1)
                {
                    <DtFieldValue Label="@_localizer["TextField.Blocks.Label"]" Value="@string.Join(", ", _result.Blocks)"/>
                }
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

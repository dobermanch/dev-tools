@page "/tools/ip-details"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

@* No input: the tool answers about the machine it runs on. See docs/known-issues.md - resolving this
   tool currently throws, which is a DI lifetime fault rather than anything on this page. *@
<DtPanes>
    <DtOutputPane
        Label="@_localizer["Label.YourIp"]"
        Text="@(_result.IpV4 ?? string.Empty)"
        DownloadFileName="ip-details.txt">
        <DtFieldList>
            <DtFieldValue Label="@_localizer["Label.YourIp"]" Value="@_result.IpV4"/>
        </DtFieldList>
    </DtOutputPane>
</DtPanes>

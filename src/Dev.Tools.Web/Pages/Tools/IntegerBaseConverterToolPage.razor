@page "/tools/int-base-converter"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

@* The base decides how the value is read, so it comes first; both are one line. *@
<DtOptions>
    <DtSelectEnum
        T="IntegerBaseConverterTool.BaseType"
        Label="@_localizer["Select.InputBase.Label"]"
        Value="@_inputBase"
        ValueToDisplay="@(type => Context.Localization.GetToolEnum(_toolDefinition, type))"
        ValueChanged="OnInputBaseValueChangedAsync"/>

    <DtTextField
        T="string"
        Class="dt-span-2"
        Label="@_localizer["TextField.Input.Label"]"
        @bind-Value="@_inputValue"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>
</DtOptions>

<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Input.Label"]"
        Text="@AllBases"
        DownloadFileName="int-base-converter.txt"
        Status="@FirstErrorText"
        StatusIsError="@(FirstErrorText is not null)">
        <DtFieldList>
            @foreach (var result in _results)
            {
                <DtFieldValue
                    Label="@Context.Localization.GetToolEnum(_toolDefinition, result.Key)"
                    Value="@result.Value?.Data"/>
            }
        </DtFieldList>
    </DtOutputPane>
</DtPanes>

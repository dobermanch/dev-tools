@page "/tools/otp"
@implements IDisposable

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtTextField
        T="string"
        Class="dt-span-2"
        Label="@_localizer["TextField.Secret.Label"]"
        @bind-Value="@_secret"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"
        Error="@(SecretError is not null)"
        ErrorText="@SecretError"/>

    <DtSelectEnum
        T="OtpTool.OtpType"
        Label="@_localizer["Select.Type.Label"]"
        Value="@_type"
        ValueToDisplay="@(type => Context.Localization.GetToolEnum(_toolDefinition, type))"
        ValueChanged="@((OtpTool.OtpType value) => SetOptionAsync(() => _type = value))"/>

    <DtSelectEnum
        T="OtpTool.OtpAlgorithm"
        Label="@_localizer["Select.Algorithm.Label"]"
        Value="@_algorithm"
        ValueToDisplay="@(algorithm => Context.Localization.GetToolEnum(_toolDefinition, algorithm))"
        ValueChanged="@((OtpTool.OtpAlgorithm value) => SetOptionAsync(() => _algorithm = value))"/>

    <DtSlider
        T="int"
        Label="@_localizer["Slider.Digits.Label"]"
        Value="@_digits"
        MinValue="6"
        MaxValue="10"
        ValueChanged="@((int value) => SetOptionAsync(() => _digits = value))"/>

    @if (_type == OtpTool.OtpType.Totp)
    {
        <DtSlider
            T="int"
            Label="@_localizer["Slider.Period.Label"]"
            Value="@_period"
            MinValue="10"
            MaxValue="120"
            ValueChanged="@((int value) => SetOptionAsync(() => _period = value))"/>
    }
    else
    {
        <DtTextField
            T="long"
            Label="@_localizer["TextField.Counter.Label"]"
            @bind-Value="@_counter"
            OnDebounceIntervalElapsed="@OnValueChangedAsync"
            ShowCopyButton="false"/>
    }

    <DtTextField
        T="string"
        Label="@_localizer["TextField.Issuer.Label"]"
        @bind-Value="@_issuer"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"
        ShowCopyButton="false"/>

    <DtTextField
        T="string"
        Label="@_localizer["TextField.AccountName.Label"]"
        @bind-Value="@_accountName"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"
        ShowCopyButton="false"/>

    <DtTextField
        T="string"
        Label="@_localizer["TextField.CodeToCheck.Label"]"
        @bind-Value="@_code"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"
        ShowCopyButton="false"/>
</DtOptions>

<div class="dt-page-actions">
    <DtButton Variant="DtButtonVariant.Outlined"
              StartIcon="@Icons.Material.Outlined.Autorenew"
              OnClick="@GenerateSecretAsync">
        @_localizer["Button.GenerateSecret.Label"]
    </DtButton>
</div>

<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Code.Label"]"
        Text="@(_result?.Code ?? string.Empty)"
        DownloadFileName="otp.txt"
        Status="@SecretError"
        StatusIsError="@(SecretError is not null)">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                <DtFieldValue Label="@_localizer["TextField.PreviousCode.Label"]" Value="@_result.PreviousCode"/>
                <DtFieldValue Label="@_localizer["TextField.Code.Label"]" Value="@_result.Code"/>
                <DtFieldValue Label="@_localizer["TextField.NextCode.Label"]" Value="@_result.NextCode"/>

                @if (_result.SecondsRemaining is { } remaining)
                {
                    <div>
                        <DtProgress Value="@remaining" Max="@_period"
                                    AriaLabel="@_localizer["Text.SecondsRemaining", remaining]"/>
                    </div>
                }

                <DtFieldValue Label="@_localizer["TextField.SecretHex.Label"]" Value="@_result.SecretHex"/>
                <DtFieldValue Label="@_localizer["TextField.Uri.Label"]" Value="@_result.Uri"/>

                @if (_result.IsValid == true)
                {
                    <DtStatus Severity="DtStatusSeverity.Success">
                        @(_result.MatchOffset == 0 ? _localizer["Text.Valid"] : _localizer["Text.ValidAtOffset", _result.MatchOffset!])
                    </DtStatus>
                }
                else if (_result.IsValid == false)
                {
                    <DtStatus Severity="DtStatusSeverity.Error">@_localizer["Text.Invalid"]</DtStatus>
                }
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

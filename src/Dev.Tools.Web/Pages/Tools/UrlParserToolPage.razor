@page "/tools/url-parser"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtPanes>
    @* One line in principle, long in practice: a short box that wraps. *@
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        MinHeight="140"
        Value="@_url"
        ValueChanged="@(value => { _url = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["TextField.Input.Label"]"
        Text="@AllParts"
        DownloadFileName="url-parser.txt"
        Status="@FirstErrorText"
        StatusIsError="@(FirstErrorText is not null)">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                <DtFieldValue Label="@_localizer["TextField.Schema.Label"]" Value="@_result.Schema"/>
                <DtFieldValue Label="@_localizer["TextField.Hostname.Label"]" Value="@_result.Hostname"/>
                <DtFieldValue Label="@_localizer["TextField.Port.Label"]" Value="@_result.Port?.ToString()"/>
                <DtFieldValue Label="@_localizer["TextField.Path.Label"]" Value="@_result.Path"/>

                @if (!string.IsNullOrEmpty(_result.Username))
                {
                    <DtFieldValue Label="@_localizer["TextField.Username.Label"]" Value="@_result.Username"/>
                }
                @if (!string.IsNullOrEmpty(_result.Password))
                {
                    <DtFieldValue Label="@_localizer["TextField.Password.Label"]" Value="@_result.Password"/>
                }
                @if (!string.IsNullOrEmpty(_result.Query))
                {
                    <DtFieldValue Label="@_localizer["TextField.Query.Label"]" Value="@_result.Query"/>
                }
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

@if (_result?.Parameters?.Count > 0)
{
    <DtTable Items="@_result.Parameters" Title="@_localizer["Section.Parameters.Title"]" MaxHeight="600">
        <HeaderContent>
            <th>@_localizer["Table.Header.Key"]</th>
            <th>@_localizer["Table.Header.Value"]</th>
        </HeaderContent>
        <RowTemplate>
            <td>@context.Key</td>
            <td>@context.Value</td>
        </RowTemplate>
    </DtTable>
}

@page "/tools/jwt-parser"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtPanes>
    @* A token is one long line: a short box that wraps. *@
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        MinHeight="140"
        Value="@_token"
        ValueChanged="@(value => { _token = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["Section.Claims.Title"]"
        Text="@AllClaims"
        DownloadFileName="jwt-parser.txt"
        Status="@FirstErrorText"
        StatusIsError="@(FirstErrorText is not null)">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                @if (!string.IsNullOrEmpty(_result.Algorithm))
                {
                    <DtFieldValue Label="@_localizer["TextField.Algorithm.Label"]" Value="@_result.Algorithm"/>
                }
                @if (!string.IsNullOrEmpty(_result.TokenType))
                {
                    <DtFieldValue Label="@_localizer["TextField.TokenType.Label"]" Value="@_result.TokenType"/>
                }
                @if (!string.IsNullOrEmpty(_result.Issuer))
                {
                    <DtFieldValue Label="@_localizer["TextField.Issuer.Label"]" Value="@_result.Issuer"/>
                }
                @if (!string.IsNullOrEmpty(_result.Subject))
                {
                    <DtFieldValue Label="@_localizer["TextField.Subject.Label"]" Value="@_result.Subject"/>
                }
                @if (!string.IsNullOrEmpty(_result.Audience))
                {
                    <DtFieldValue Label="@_localizer["TextField.Audience.Label"]" Value="@_result.Audience"/>
                }
                @if (!string.IsNullOrEmpty(_result.IssuedAt))
                {
                    <DtFieldValue Label="@_localizer["TextField.IssuedAt.Label"]" Value="@_result.IssuedAt"/>
                }
                @if (!string.IsNullOrEmpty(_result.NotBefore))
                {
                    <DtFieldValue Label="@_localizer["TextField.NotBefore.Label"]" Value="@_result.NotBefore"/>
                }
                @if (!string.IsNullOrEmpty(_result.ExpiresAt))
                {
                    <DtFieldValue Label="@_localizer["TextField.ExpiresAt.Label"]" Value="@_result.ExpiresAt"/>
                }
                @if (!string.IsNullOrEmpty(_result.JwtId))
                {
                    <DtFieldValue Label="@_localizer["TextField.JwtId.Label"]" Value="@_result.JwtId"/>
                }
                <DtFieldValue Label="@_localizer["TextField.Signature.Label"]" Value="@_result.Signature"/>
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

@if (_result is { HasErrors: false })
{
    <DtPanes>
        <DtOutputPane
            Label="@_localizer["TextField.HeaderJson.Label"]"
            Text="@(_result.HeaderJson ?? string.Empty)"
            DownloadFileName="jwt-header.json"/>

        <DtOutputPane
            Label="@_localizer["TextField.PayloadJson.Label"]"
            Text="@(_result.PayloadJson ?? string.Empty)"
            DownloadFileName="jwt-payload.json"/>
    </DtPanes>
}

@if (_result?.Claims?.Count > 0)
{
    <DtTable Items="@_result.Claims" Title="@_localizer["Section.Claims.Title"]">
        <HeaderContent>
            <th>@_localizer["Table.Header.Claim"]</th>
            <th>@_localizer["Table.Header.Value"]</th>
        </HeaderContent>
        <RowTemplate>
            <td>@context.Key</td>
            <td>@context.Value</td>
        </RowTemplate>
    </DtTable>
}

@page "/tools/html-entities"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSelectEnum
        T="HtmlEntitiesTool.TranscodingType"
        Label="@_localizer["Select.Operation.Label"]"
        Value="@_transcoding"
        ValueToDisplay="@(type => Context.Localization.GetToolEnum(_toolDefinition, type))"
        ValueChanged="OnTranscodingChangedAsync"/>

    <DtSwitch
        Value="@_encodeNonAscii"
        Label="@_localizer["Switch.EncodeNonAscii.Label"]"
        Disabled="@(_transcoding == HtmlEntitiesTool.TranscodingType.Decode)"
        ValueChanged="OnEncodeNonAsciiChangedAsync"/>
</DtOptions>

<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        AllowFileInput="true"
        Value="@_text"
        ValueChanged="@(value => { _text = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["TextField.Result.Label"]"
        Text="@(_result?.Text ?? string.Empty)"
        DownloadFileName="html-entities.txt"
        Status="@(_result is { HasErrors: true } ? Context.Localization.GetErrorCode(_result.Errors[0].Code) : null)"
        StatusIsError="@(_result?.HasErrors ?? false)"/>
</DtPanes>

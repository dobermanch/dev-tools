@page "/tools/qr-code"
@using MudBlazor.Utilities

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<MudCard Class="my-4">
    <MudCardContent>
        <DtSection Id="content" Class="mt-0">
            <MudGrid Class="align-center" Spacing="4">
                <MudItem xs="12" md="4">
                    <DtSelectEnum
                        T="QrCodeTool.QrContent"
                        Label="@_localizer["Select.Content.Label"]"
                        Value="@_content"
                        ValueToDisplay="@(content => Context.Localization.GetToolEnum(_toolDefinition, content))"
                        ValueChanged="@((QrCodeTool.QrContent value) => SetOptionAsync(() => _content = value))"
                    />
                </MudItem>
                <MudItem xs="12" md="8">
                    <DtTextField
                        T="string"
                        Label="@(_localizer[$"TextField.Text.{_content}.Label"])"
                        @bind-Value="@_text"
                        OnDebounceIntervalElapsed="@OnValueChangedAsync"
                        Error="@(ErrorFor(nameof(QrCodeTool.Args.Text)) is not null)"
                        ErrorText="@ErrorFor(nameof(QrCodeTool.Args.Text))"
                        ShowCopyButton="false"
                        LabelPosition="LabelPositionType.Inline"
                    />
                </MudItem>
                @if (_content == QrCodeTool.QrContent.WiFi)
                {
                    <MudItem xs="12" md="4">
                        <DtSelectEnum
                            T="QrCodeTool.WifiSecurity"
                            Label="@_localizer["Select.Security.Label"]"
                            Value="@_security"
                            ValueToDisplay="@(security => Context.Localization.GetToolEnum(_toolDefinition, security))"
                            ValueChanged="@((QrCodeTool.WifiSecurity value) => SetOptionAsync(() => _security = value))"
                        />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        @if (_security != QrCodeTool.WifiSecurity.None)
                        {
                            <DtTextField
                                T="string"
                                Label="@_localizer["TextField.Password.Label"]"
                                @bind-Value="@_password"
                                OnDebounceIntervalElapsed="@OnValueChangedAsync"
                                Error="@(ErrorFor(nameof(QrCodeTool.Args.Password)) is not null)"
                                ErrorText="@ErrorFor(nameof(QrCodeTool.Args.Password))"
                                ShowCopyButton="false"
                                LabelPosition="LabelPositionType.Inline"
                            />
                        }
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSwitch
                            T="bool"
                            Value="@_hidden"
                            Label="@_localizer["Switch.Hidden.Label"]"
                            Color="Color.Primary"
                            ValueChanged="@((bool value) => SetOptionAsync(() => _hidden = value))"/>
                    </MudItem>
                }
            </MudGrid>
        </DtSection>

        <DtSection Id="appearance" ShowDivider="true">
            <MudGrid Class="align-center" Spacing="4">
                <MudItem xs="12" md="3">
                    <DtSelectEnum
                        T="QrCodeTool.QrErrorCorrection"
                        Label="@_localizer["Select.ErrorCorrection.Label"]"
                        Value="@_errorCorrection"
                        ValueToDisplay="@(level => Context.Localization.GetToolEnum(_toolDefinition, level))"
                        ValueChanged="@((QrCodeTool.QrErrorCorrection value) => SetOptionAsync(() => _errorCorrection = value))"
                    />
                </MudItem>
                <MudItem xs="12" md="3">
                    <DtSlider
                        T="int"
                        Label="@_localizer["Slider.Border.Label"]"
                        Value="@_border"
                        MinValue="0"
                        MaxValue="10"
                        ValueChanged="@((int value) => SetOptionAsync(() => _border = value))"/>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudColorPicker
                        Label="@_localizer["ColorPicker.Dark.Label"]"
                        Value="@_dark"
                        ValueChanged="@((MudColor value) => SetOptionAsync(() => _dark = value))"
                        PickerVariant="PickerVariant.Inline"/>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudColorPicker
                        Label="@_localizer["ColorPicker.Light.Label"]"
                        Value="@_light"
                        ValueChanged="@((MudColor value) => SetOptionAsync(() => _light = value))"
                        PickerVariant="PickerVariant.Inline"/>
                </MudItem>
            </MudGrid>
        </DtSection>

        @if (_result is { HasErrors: false })
        {
            <DtSection Id="output" ShowDivider="true">
                <MudGrid Spacing="4">
                    <MudItem xs="12" md="4">
                        <div style="width: 100%; max-width: 320px;">@((MarkupString)InlineSvg)</div>
                        <MudText Typo="Typo.caption">@_localizer["Text.Details", _result.Version, _result.Size]</MudText>
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <DtTextField T="string" Value="@_result.Payload" Label="@_localizer["TextField.Payload.Label"]"
                                     ReadOnly="true" LabelPosition="LabelPositionType.Inline"/>
                        <DtTextField T="string" Value="@_result.Svg" Label="@_localizer["TextField.Svg.Label"]"
                                     ReadOnly="true" Lines="8" Class="mt-4" LabelPosition="LabelPositionType.Inline"/>
                    </MudItem>
                </MudGrid>
            </DtSection>
        }
    </MudCardContent>
</MudCard>

@page "/tools/ip-converter"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

@* An address is one line. *@
<DtOptions>
    <DtTextField
        T="string"
        Class="dt-span-2"
        Label="@_localizer["TextField.Input.Label"]"
        @bind-Value="@_input"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"
        Error="@(InputError is not null)"
        ErrorText="@InputError"/>
</DtOptions>

<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Input.Label"]"
        Text="@AllRepresentations"
        DownloadFileName="ip-converter.txt"
        Status="@InputError"
        StatusIsError="@(InputError is not null)">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                @if (_result.Ipv4 is not null)
                {
                    <DtFieldValue Label="@_localizer["TextField.Ipv4.Label"]" Value="@_result.Ipv4"/>
                }
                <DtFieldValue Label="@_localizer["TextField.Decimal.Label"]" Value="@_result.Decimal"/>
                <DtFieldValue Label="@_localizer["TextField.Hexadecimal.Label"]" Value="@_result.Hexadecimal"/>
                <DtFieldValue Label="@_localizer["TextField.Binary.Label"]" Value="@_result.Binary"/>
                <DtFieldValue Label="@_localizer["TextField.Ipv6.Label"]" Value="@_result.Ipv6"/>
                <DtFieldValue Label="@_localizer["TextField.Ipv6Expanded.Label"]" Value="@_result.Ipv6Expanded"/>
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

@page "/tools/bcrypt"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSelectEnum
        T="BcryptTool.BcryptOperation"
        Label="@_localizer["Select.Operation.Label"]"
        Value="@_operation"
        ValueToDisplay="@(operation => Context.Localization.GetToolEnum(_toolDefinition, operation))"
        ValueChanged="@((BcryptTool.BcryptOperation value) => SetOperation(value))"/>

    <DtTextField
        T="string"
        Class="dt-span-2"
        Label="@_localizer["TextField.Password.Label"]"
        @bind-Value="@_password"
        Error="@(ErrorFor(nameof(BcryptTool.Args.Password)) is not null)"
        ErrorText="@ErrorFor(nameof(BcryptTool.Args.Password))"
        ShowCopyButton="false"/>

    @if (_operation == BcryptTool.BcryptOperation.Hash)
    {
        <DtSlider
            T="int"
            Label="@_localizer["Slider.Cost.Label"]"
            Value="@_cost"
            MinValue="4"
            MaxValue="12"
            Hint="@_localizer["Text.CostHint"]"
            ValueChanged="@((int value) => _cost = value)"/>
    }
    else
    {
        <DtTextField
            T="string"
            Class="dt-span-all"
            Label="@_localizer["TextField.Hash.Label"]"
            @bind-Value="@_hash"
            Error="@(ErrorFor(nameof(BcryptTool.Args.Hash)) is not null)"
            ErrorText="@ErrorFor(nameof(BcryptTool.Args.Hash))"
            ShowCopyButton="false"/>
    }

</DtOptions>

@* Run on request: bcrypt is slow on purpose, and slower again in the browser. *@
<div class="dt-page-actions">
    <DtButton Loading="@_running" OnClick="@RunAsync">
        @_localizer[$"Button.{_operation}.Label"]
    </DtButton>
</div>

<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Result.Label"]"
        Text="@(_result?.Hash ?? string.Empty)"
        DownloadFileName="bcrypt.txt">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                @if (_result.Matches is { } matches)
                {
                    <DtStatus Severity="@(matches ? DtStatusSeverity.Success : DtStatusSeverity.Error)">
                        @_localizer[matches ? "Text.Matches" : "Text.NoMatch"]
                    </DtStatus>
                }
                else
                {
                    <DtFieldValue Label="@_localizer["TextField.Result.Label"]" Value="@_result.Hash"/>
                }

                <DtFieldValue Label="@_localizer["TextField.Version.Label"]" Value="@_result.Version"/>
                <DtFieldValue Label="@_localizer["TextField.Cost.Label"]" Value="@_result.Cost.ToString()"/>
                <DtFieldValue Label="@_localizer["TextField.Salt.Label"]" Value="@_result.Salt"/>

                @if (_result.PasswordTruncated)
                {
                    <DtStatus Severity="DtStatusSeverity.Warning">@_localizer["Text.Truncated"]</DtStatus>
                }
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

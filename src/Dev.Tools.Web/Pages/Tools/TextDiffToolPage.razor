@page "/tools/text-diff"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSwitch Value="@_ignoreWhitespace" Label="@_localizer["Switch.IgnoreWhitespace.Label"]"
              ValueChanged="@((bool value) => SetOptionAsync(() => _ignoreWhitespace = value))"/>
    <DtSwitch Value="@_ignoreCase" Label="@_localizer["Switch.IgnoreCase.Label"]"
              ValueChanged="@((bool value) => SetOptionAsync(() => _ignoreCase = value))"/>
    <DtSlider
        T="int"
        Label="@_localizer["Slider.ContextLines.Label"]"
        Value="@_contextLines"
        MinValue="0"
        MaxValue="20"
        ValueChanged="@((int value) => SetOptionAsync(() => _contextLines = value))"/>
</DtOptions>

@* Two inputs, which is what the pane grid is for. *@
<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Original.Label"]"
        AllowFileInput="true"
        Value="@_original"
        ValueChanged="@(value => { _original = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtInputPane
        Label="@_localizer["TextField.Modified.Label"]"
        AllowFileInput="true"
        Value="@_modified"
        ValueChanged="@(value => { _modified = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>
</DtPanes>

<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Diff.Label"]"
        Text="@(_result?.Diff ?? string.Empty)"
        DownloadFileName="text-diff.diff"
        Status="@DiffStatus"
        StatusIsError="@(FirstErrorText is not null)">
        @if (_result is { HasErrors: false, HasChanges: true })
        {
            <div class="dt-diff">
                @foreach (var line in _result.Lines)
                {
                    <div class="dt-diff-line" style="@LineStyle(line.Kind)">
                        <span class="dt-diff-number">@line.OriginalLine</span>
                        <span class="dt-diff-number">@line.ModifiedLine</span>
                        <span class="dt-diff-marker">@Marker(line.Kind)</span>
                        <span class="dt-diff-text">@line.Text</span>
                    </div>
                }
            </div>
        }
    </DtOutputPane>
</DtPanes>

@page "/tools/char-viewer"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSelectEnum
        T="CharacterViewerTool.ViewType"
        Label="@_localizer["Select.ViewType.Label"]"
        Value="@_args.ViewType"
        ValueToDisplay="@(type => Context.Localization.GetToolEnum(_toolDefinition, type))"
        ValueChanged="OnViewTypeChangedAsync"/>

    @if (HideSymbolsOptions)
    {
        <DtSwitch @bind-Value="@_showSymbols" Label="@_localizer["Switch.ShowSymbols.Label"]"/>
    }
</DtOptions>

<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        AllowFileInput="true"
        Value="@_args.Text"
        ValueChanged="@(value => { _args.Text = value; })"
        OnDebounceIntervalElapsed="OnTextValueChangedAsync"/>

    @* The body is the marked-up text, where every odd character is highlighted and titled. *@
    <DtOutputPane
        Label="@_localizer["TextField.Output.Label"]"
        Text="@_result.Text"
        DownloadFileName="char-viewer.txt"
        Status="@FirstErrorText"
        StatusIsError="@(FirstErrorText is not null)">
        <pre class="dt-char-view">@FormatText(_result.Text)</pre>
    </DtOutputPane>
</DtPanes>

@if (_result.CharInfos.Count > 0)
{
    <DtTable Items="@_result.CharInfos" Title="@_localizer["Section.CharacterInfo.Title"]" MaxHeight="600">
        <HeaderContent>
            <th>@_localizer["Table.Header.Char"]</th>
            <th>@_localizer["Table.Header.Category"]</th>
            <th>@_localizer["Table.Header.Printable"]</th>
            <th>@_localizer["Table.Header.Hex"]</th>
            <th>@_localizer["Table.Header.Unicode"]</th>
            <th>@_localizer["Table.Header.ASCII"]</th>
            <th>@_localizer["Table.Header.HTML"]</th>
            <th>@_localizer["Table.Header.URL"]</th>
        </HeaderContent>
        <RowTemplate>
            <td>@context.Char</td>
            <td>@context.UnicodeCategory</td>
            <td>@CharToDisplay(context.Char)</td>
            <td>@context.HexCode</td>
            <td>@context.UnicodeDisplayString</td>
            <td>@context.AsciiCode</td>
            <td>@context.HtmlString</td>
            <td>@context.UrlString</td>
        </RowTemplate>
    </DtTable>
}

@page "/tools/roman-converter"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSelectEnum
        T="IntegerToRomanConverterTool.TranscodingType"
        Label="@_localizer["Select.Direction.Label"]"
        Value="@_transcoding"
        ValueToDisplay="@(type => Context.Localization.GetToolEnum(_toolDefinition, type))"
        ValueChanged="OnTranscodingValueChangedAsync"/>
</DtOptions>

@* The range check the field used to carry lives in the tool, which reports it as an error; the status
   line under the result is where the design shows that. *@
<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        Value="@_number"
        ValueChanged="@(value => { _number = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["TextField.Result.Label"]"
        Text="@(_result?.Number ?? string.Empty)"
        DownloadFileName="roman-converter.txt"
        Status="@(_result is { HasErrors: true } ? Context.Localization.GetErrorCode(_result.Errors[0].Code) : null)"
        StatusIsError="@(_result?.HasErrors ?? false)"/>
</DtPanes>

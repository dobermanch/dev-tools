@page "/tools/encryption"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSelectEnum
        T="EncryptionTool.EncryptionOperation"
        Label="@_localizer["Select.Operation.Label"]"
        Value="@_operation"
        ValueToDisplay="@(operation => Context.Localization.GetToolEnum(_toolDefinition, operation))"
        ValueChanged="@((EncryptionTool.EncryptionOperation value) => SetOptionAsync(() => _operation = value))"/>

    @* A key is long: it takes two columns, and keeps its own error, which is not the input's. *@
    <DtTextField
        T="string"
        Class="dt-span-2"
        Value="@_key"
        Label="@_localizer["TextField.Key.Label"]"
        Error="@(KeyError is not null)"
        ErrorText="@KeyError"
        ShowCopyButton="false"
        OnDebounceIntervalElapsed="OnKeyChangedAsync"/>

    <DtSelectEnum
        T="EncryptionTool.EncryptionAlgorithm"
        Label="@_localizer["Select.Algorithm.Label"]"
        Value="@_algorithm"
        ValueToDisplay="@(algorithm => Context.Localization.GetToolEnum(_toolDefinition, algorithm))"
        ValueChanged="@((EncryptionTool.EncryptionAlgorithm value) => SetOptionAsync(() => _algorithm = value))"/>

    <DtSelectEnum
        T="EncryptionTool.CiphertextFormat"
        Label="@_localizer["Select.Format.Label"]"
        Value="@_format"
        ValueToDisplay="@(format => Context.Localization.GetToolEnum(_toolDefinition, format))"
        ValueChanged="@((EncryptionTool.CiphertextFormat value) => SetOptionAsync(() => _format = value))"/>
</DtOptions>

<DtPanes>
    <DtInputPane
        Label="@(_localizer[$"TextField.Input.{_operation}.Label"])"
        AllowFileInput="true"
        Value="@_text"
        ValueChanged="@(value => { _text = value; })"
        OnDebounceIntervalElapsed="OnTextChangedAsync"/>

    <DtOutputPane
        Label="@(_localizer[$"TextField.Result.{_operation}.Label"])"
        Text="@(_result?.Text ?? string.Empty)"
        DownloadFileName="encryption.txt"
        Status="@InputError"
        StatusIsError="@(InputError is not null)"/>
</DtPanes>

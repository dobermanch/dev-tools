@page "/tools/text-statistics"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        AllowFileInput="true"
        Value="@_text"
        ValueChanged="@(value => { _text = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["TextField.Input.Label"]"
        Text="@AllStatistics"
        DownloadFileName="text-statistics.txt">
        <DtFieldList>
            <DtFieldValue Label="@_localizer["TextField.Characters.Label"]" Value="@_result.Characters.ToString()"/>
            <DtFieldValue Label="@_localizer["TextField.NonWhitespaceCharacters.Label"]" Value="@_result.NonWhitespaceCharacters.ToString()"/>
            <DtFieldValue Label="@_localizer["TextField.Words.Label"]" Value="@_result.Words.ToString()"/>
            <DtFieldValue Label="@_localizer["TextField.Lines.Label"]" Value="@_result.Lines.ToString()"/>
            <DtFieldValue Label="@_localizer["TextField.Paragraphs.Label"]" Value="@_result.Paragraphs.ToString()"/>
            <DtFieldValue Label="@_localizer["TextField.Utf8Bytes.Label"]" Value="@_result.Utf8Bytes.ToString()"/>
            <DtFieldValue Label="@_localizer["TextField.Utf16Length.Label"]" Value="@_result.Utf16Length.ToString()"/>
        </DtFieldList>
    </DtOutputPane>
</DtPanes>

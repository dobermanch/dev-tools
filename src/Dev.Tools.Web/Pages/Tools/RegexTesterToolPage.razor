@page "/tools/regex-tester"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<MudCard Class="my-4">
    <MudCardContent>
        <DtSection Id="pattern" Class="mt-0">
            <MudGrid Class="align-center" Spacing="4">
                <MudItem xs="12" md="6">
                    <DtTextField
                        T="string"
                        Label="@_localizer["TextField.Pattern.Label"]"
                        @bind-Value="@_pattern"
                        OnDebounceIntervalElapsed="@OnValueChangedAsync"
                        Error="@(PatternError is not null)"
                        ErrorText="@PatternError"
                        LabelPosition="LabelPositionType.Inline"
                    />
                </MudItem>
                <MudItem xs="12" md="6">
                    <DtTextField
                        T="string"
                        Label="@_localizer["TextField.Replacement.Label"]"
                        @bind-Value="@_replacement"
                        OnDebounceIntervalElapsed="@OnValueChangedAsync"
                        LabelPosition="LabelPositionType.Inline"
                    />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <DtSwitch
                        Value="@_ignoreCase"
                        Label="@_localizer["Switch.IgnoreCase.Label"]"
                        ValueChanged="@((bool value) => SetOptionAsync(() => _ignoreCase = value))"/>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <DtSwitch
                        Value="@_multiline"
                        Label="@_localizer["Switch.Multiline.Label"]"
                        ValueChanged="@((bool value) => SetOptionAsync(() => _multiline = value))"/>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <DtSwitch
                        Value="@_singleline"
                        Label="@_localizer["Switch.Singleline.Label"]"
                        ValueChanged="@((bool value) => SetOptionAsync(() => _singleline = value))"/>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <DtSwitch
                        Value="@_ignorePatternWhitespace"
                        Label="@_localizer["Switch.IgnorePatternWhitespace.Label"]"
                        ValueChanged="@((bool value) => SetOptionAsync(() => _ignorePatternWhitespace = value))"/>
                </MudItem>
            </MudGrid>
        </DtSection>

        <DtSection Id="text" ShowDivider="true">
            <MudGrid Class="align-center" Spacing="4">
                <MudItem xs="12">
                    <DtTextField
                        T="string"
                        AllowFileInput="true"
                        Label="@_localizer["TextField.Text.Label"]"
                        @bind-Value="@_text"
                        OnDebounceIntervalElapsed="@OnValueChangedAsync"
                        Error="@(TextError is not null)"
                        ErrorText="@TextError"
                        Lines="10"
                        LabelPosition="LabelPositionType.Inline"
                    />
                </MudItem>
            </MudGrid>
        </DtSection>

        @if (_result is { HasErrors: false })
        {
            <DtSection Id="output" ShowDivider="true">
                <MudGrid Class="align-center" Spacing="4">
                    <MudItem xs="12" md="3">
                        <DtTextField
                            T="int"
                            Value="@_result.MatchCount"
                            Label="@_localizer["TextField.MatchCount.Label"]"
                            ReadOnly="true"
                            LabelPosition="LabelPositionType.Inline"/>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(_replacement))
                    {
                        <MudItem xs="12">
                            <DtTextField
                                T="string"
                                Value="@_result.Output"
                                Label="@_localizer["TextField.Result.Label"]"
                                ReadOnly="true"
                                Lines="10"
                                LabelPosition="LabelPositionType.Inline"/>
                        </MudItem>
                    }
                    @if (_result.Matches.Count > 0)
                    {
                        <MudItem xs="12">
                            <MudTable Items="@_result.Matches" Elevation="0" Dense="true" Hover="true" Bordered="true"
                                      Striped="false" Height="600" HorizontalScrollbar="true">
                                <HeaderContent>
                                    <MudTh>@_localizer["Table.Header.Position"]</MudTh>
                                    <MudTh>@_localizer["Table.Header.Index"]</MudTh>
                                    <MudTh>@_localizer["Table.Header.Value"]</MudTh>
                                    <MudTh>@_localizer["Table.Header.Groups"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@($"{context.Line}:{context.Column}")</MudTd>
                                    <MudTd>@context.Index</MudTd>
                                    <MudTd>@context.Value</MudTd>
                                    <MudTd>@DescribeGroups(context)</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                    }
                </MudGrid>
            </DtSection>
        }
    </MudCardContent>
</MudCard>

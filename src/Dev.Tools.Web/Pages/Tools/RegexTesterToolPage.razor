@page "/tools/regex-tester"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtTextField
        T="string"
        Class="dt-span-2"
        Label="@_localizer["TextField.Pattern.Label"]"
        @bind-Value="@_pattern"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"
        Error="@(PatternError is not null)"
        ErrorText="@PatternError"/>

    <DtTextField
        T="string"
        Class="dt-span-2"
        Label="@_localizer["TextField.Replacement.Label"]"
        @bind-Value="@_replacement"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtSwitch Value="@_ignoreCase" Label="@_localizer["Switch.IgnoreCase.Label"]"
              ValueChanged="@((bool value) => SetOptionAsync(() => _ignoreCase = value))"/>
    <DtSwitch Value="@_multiline" Label="@_localizer["Switch.Multiline.Label"]"
              ValueChanged="@((bool value) => SetOptionAsync(() => _multiline = value))"/>
    <DtSwitch Value="@_singleline" Label="@_localizer["Switch.Singleline.Label"]"
              ValueChanged="@((bool value) => SetOptionAsync(() => _singleline = value))"/>
    <DtSwitch Value="@_ignorePatternWhitespace" Label="@_localizer["Switch.IgnorePatternWhitespace.Label"]"
              ValueChanged="@((bool value) => SetOptionAsync(() => _ignorePatternWhitespace = value))"/>
</DtOptions>

<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Text.Label"]"
        AllowFileInput="true"
        Value="@_text"
        ValueChanged="@(value => { _text = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["Section.Matches.Title"]"
        Text="@(_result?.Output ?? string.Empty)"
        DownloadFileName="regex-tester.txt"
        Status="@(PatternError ?? TextError)"
        StatusIsError="@(PatternError is not null || TextError is not null)">
        @if (_result is { HasErrors: false })
        {
            <DtFieldList>
                <DtFieldValue Label="@_localizer["TextField.MatchCount.Label"]" Value="@_result.MatchCount.ToString()"/>
                @if (!string.IsNullOrEmpty(_replacement))
                {
                    <DtFieldValue Label="@_localizer["TextField.Result.Label"]" Value="@_result.Output"/>
                }
            </DtFieldList>
        }
    </DtOutputPane>
</DtPanes>

@if (_result?.Matches.Count > 0)
{
    <DtTable Items="@_result.Matches" Title="@_localizer["Section.Matches.Title"]" MaxHeight="600">
        <HeaderContent>
            <th>@_localizer["Table.Header.Position"]</th>
            <th>@_localizer["Table.Header.Index"]</th>
            <th>@_localizer["Table.Header.Value"]</th>
            <th>@_localizer["Table.Header.Groups"]</th>
        </HeaderContent>
        <RowTemplate>
            <td>@($"{context.Line}:{context.Column}")</td>
            <td>@context.Index</td>
            <td>@context.Value</td>
            <td>@DescribeGroups(context)</td>
        </RowTemplate>
    </DtTable>
}

@page "/tools/url-transcoder"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSelectEnum
        T="SafeUrlTranscoderTool.TranscodingType"
        Label="@_localizer["Select.Operation.Label"]"
        Value="@_transcoding"
        ValueToDisplay="@(type => Context.Localization.GetToolEnum(_toolDefinition, type))"
        ValueChanged="OnTranscodingValueChangedAsync"/>
</DtOptions>

<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        AllowFileInput="true"
        Value="@_url"
        ValueChanged="@(value => { _url = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["TextField.Result.Label"]"
        Text="@(_result?.Url ?? string.Empty)"
        DownloadFileName="url-transcoder.txt"
        Status="@(_result is { HasErrors: true } ? Context.Localization.GetErrorCode(_result.Errors[0].Code) : null)"
        StatusIsError="@(_result?.HasErrors ?? false)"/>
</DtPanes>

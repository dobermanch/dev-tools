@page "/tools/token-generator"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSlider
        T="int"
        Label="@_localizer["Slider.TokenLength.Label"]"
        Value="@_args.TokenLength"
        MinValue="1"
        MaxValue="512"
        ValueChanged="OnTokenLengthValueChangedAsync"/>

    <DtSlider
        T="int"
        Label="@_localizer["Slider.TokenCount.Label"]"
        Value="@_args.TokenCount"
        MinValue="1"
        MaxValue="100"
        ValueChanged="OnTokenCountValueChangedAsync"/>

    <DtTextField
        T="string"
        Label="@_localizer["TextField.Alphabet.Label"]"
        @bind-Value="@_args.Alphabet"
        ShowCopyButton="false"
        OnDebounceIntervalElapsed="OnValueChangedAsync"/>

    <DtTextField
        T="string"
        Label="@_localizer["TextField.ExcludeSymbols.Label"]"
        @bind-Value="@_args.ExcludeSymbols"
        ShowCopyButton="false"
        OnDebounceIntervalElapsed="OnValueChangedAsync"/>

    <DtSwitch Value="@_args.Lowercase" Label="@_localizer["Switch.Lowercase.Label"]" ValueChanged="OnLowercaseValueChangedAsync"/>
    <DtSwitch Value="@_args.Uppercase" Label="@_localizer["Switch.Uppercase.Label"]" ValueChanged="OnUppercaseValueChangedAsync"/>
    <DtSwitch Value="@_args.Numbers" Label="@_localizer["Switch.Numbers.Label"]" ValueChanged="OnNumbersValueChangedAsync"/>
    <DtSwitch Value="@_args.Symbols" Label="@_localizer["Switch.Symbols.Label"]" ValueChanged="OnSymbolsValueChangedAsync"/>
</DtOptions>

@* A generator has no input pane; refresh draws a new set with the same options. *@
<DtPanes>
    <DtOutputPane
        Label="@_localizer["TextField.Result.Label"]"
        Text="@GetTokens()"
        DownloadFileName="token-generator.txt"
        OnRefresh="OnValueChangedAsync"
        Status="@FirstErrorText"
        StatusIsError="@(FirstErrorText is not null)"/>
</DtPanes>

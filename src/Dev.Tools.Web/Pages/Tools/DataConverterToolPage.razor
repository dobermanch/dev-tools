@page "/tools/data-converter"

<DtToolPageHeader ToolDefinition="@_toolDefinition"/>

<DtOptions>
    <DtSelectEnum
        T="DataConverterTool.SourceFormat"
        Label="@_localizer["Select.From.Label"]"
        Value="@_from"
        ValueToDisplay="@(format => Context.Localization.GetToolEnum(_toolDefinition, format))"
        ValueChanged="OnFromChangedAsync"/>

    <DtSelectEnum
        T="DataConverterTool.TargetFormat"
        Label="@_localizer["Select.To.Label"]"
        Value="@_to"
        ValueToDisplay="@(format => Context.Localization.GetToolEnum(_toolDefinition, format))"
        ValueChanged="OnToChangedAsync"/>
</DtOptions>

@* The tool separates the two failures - source that will not parse, and data the target format cannot
   hold - and both belong under the result, which is where the status line is. *@
<DtPanes>
    <DtInputPane
        Label="@_localizer["TextField.Input.Label"]"
        AllowFileInput="true"
        Value="@_text"
        ValueChanged="@(value => { _text = value; })"
        OnDebounceIntervalElapsed="@OnValueChangedAsync"/>

    <DtOutputPane
        Label="@_localizer["TextField.Result.Label"]"
        Text="@(_result?.Text ?? string.Empty)"
        DownloadFileName="data-converter.txt"
        Status="@(InputError ?? OutputError)"
        StatusIsError="@(InputError is not null || OutputError is not null)"/>
</DtPanes>

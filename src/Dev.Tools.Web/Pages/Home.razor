@page "/"
@using Dev.Tools.Web.Services.Layout

<PageTitle>@Context.AppDetails.Name</PageTitle>

<section class="dt-hero">
    <span class="dt-hero-badge">
        <span class="dt-hero-dot"></span>
        @string.Format(_localizer["Hero.Badge"], _toolCount, _categoryCount)
    </span>

    <h1 class="dt-hero-title">
        @_localizer["Hero.Title.Line1"]<br />
        <span class="dt-hero-accent">@_localizer["Hero.Title.Line2"]</span>
    </h1>

    <p class="dt-hero-text">@_localizer["Hero.Description"]</p>

    <div class="dt-hero-search">
        <DtIcon Icon="@Icons.Material.Outlined.Search" Size="DtControlSize.Large" />
        <input type="search"
               value="@_query"
               placeholder="@_localizer["Search.Placeholder"]"
               aria-label="@_localizer["Search.Placeholder"]"
               @oninput="OnQueryChangedAsync" />
    </div>
</section>

<section class="dt-filter-row">
    <span class="dt-label-mono dt-label-mono-section">@_localizer["Filter.Label"]</span>

    <div class="dt-filter-chips">
        <DtChip Text="@_localizer["Filter.All"]"
                Selected="@(_category is null && !_favoritesOnly)"
                OnClick="@(() => SelectCategoryAsync(null))"/>

        @foreach (var category in _categories)
        {
            <DtChip Text="@Context.Localization.GetCategory(category)"
                    Count="@CountFor(category)"
                    Selected="@(_category == category)"
                    OnClick="@(() => SelectCategoryAsync(category))"/>
        }
    </div>

    <DtToggleGroup T="bool" Value="@_groupByCategory" ValueChanged="OnGroupByCategoryChangedAsync"
                   Options="@GroupingOptions"/>

    <DtToggleGroup T="ViewMode" Value="@_viewMode" ValueChanged="OnViewModeChangedAsync"
                   Options="@ViewModeOptions"/>
</section>

@if (_favoritesOnly || _recentOnly)
{
    @* One list, in the order the view implies - starred tools by category, recent ones by when. *@
    <DtSection Id="view"
               Caption="@(_recentOnly ? _localizer["Section.Recent"] : _localizer["Section.Favorites"])"
               Count="@_visibleTools.Count.ToString()">
        @ToolsView(_visibleTools)
    </DtSection>
}
else if (_visibleTools.Count == 0)
{
    <div class="dt-empty">
        <DtIcon Icon="@Icons.Material.Outlined.SearchOff" Pixels="24" />
        <span class="dt-empty-title">@_localizer["Empty.Title"]</span>
        <span class="dt-empty-text">@_localizer["Empty.Description"]</span>
    </div>
}
else if (_groupByCategory)
{
    @foreach (var group in _visibleGroups)
    {
        <section class="dt-category">
            <div class="dt-category-head">
                <span class="dt-category-icon">
                    <DtIcon Icon="@ToolIconProvider.GetCategoryIcon(group.Key)" />
                </span>
                <h2 class="dt-category-name">@Context.Localization.GetCategory(group.Key)</h2>
                <span class="dt-category-count">@string.Format(_localizer["Section.ToolCount"], group.Data.Count)</span>
            </div>

            @ToolsView(group.Data)
        </section>
    }
}
else
{
    <section class="dt-category">
        @ToolsView(_visibleTools)
    </section>
}

@* One place deciding cards or rows, whatever the section. *@
@code {
    private RenderFragment ToolsView(IEnumerable<ToolDefinition> tools) => @<text>
        @if (_viewMode == ViewMode.Cards)
        {
            <div class="dt-card-grid">
                @foreach (var tool in tools)
                {
                    <ToolCard Tool="@tool" />
                }
            </div>
        }
        else
        {
            <ToolListView Tools="@tools" />
        }
    </text>;
}

@page "/settings"

@using Dev.Tools.Localization

<DtPageHeader Caption="@_localizer["Caption"]"/>

<DtStatus Severity="DtStatusSeverity.Info" Class="dt-settings-note">@_localizer["Note.BrowserStorage"]</DtStatus>

<DtOptions Label="@_localizer["Section.General.Label"]">
    <DtSelectEnum
        T="Dev.Tools.Web.Services.Layout.ThemeMode"
        Label="@_localizer["Section.General.Theme.Label"]"
        Value="@Context.Layout.ThemeMode"
        ValueChanged="@(async mode => await OnThemeChangedAsync(mode))"/>

    <LanguageSelector Label="@_localizer["Section.General.Language.Label"]"/>
</DtOptions>

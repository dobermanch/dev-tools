@typeparam T
@*
    A single-line value in the shared box, with copy inside it. Anything someone pastes belongs in a
    DtInputPane instead, which is why this no longer has a multi-line form.
*@

<DtField Label="@Label"
         For="@_id"
         Error="@Error"
         ErrorText="@ErrorText"
         Hint="@Hint"
         Class="@Class">
    <div class="dt-box @(Error ? "dt-box-error" : null)">
        <input id="@_id"
               type="@HtmlInputType"
               value="@_text"
               maxlength="@MaxLength"
               spellcheck="false"
               @oninput="OnInputAsync" />

        @if (ShowCopyButton)
        {
            <DtCopyButton Text="@_text" />
        }
    </div>
</DtField>

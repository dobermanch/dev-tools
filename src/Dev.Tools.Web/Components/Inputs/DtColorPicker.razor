@using MudBlazor.Utilities
@*
    MudBlazor's colour picker in the shared box: rebuilding a picker with alpha and a palette would
    buy nothing, so the picker stays and only the frame it draws is taken away. The box is .dt-box,
    the same one the fields and the select sit in, which is what keeps an options grid aligned.
*@

<DtField Label="@Label" Hint="@Hint" Class="@Class">
    <div class="dt-box dt-color-picker">
        <MudColorPicker Value="@Value"
                        ValueChanged="@ValueChanged"
                        ShowAlpha="@ShowAlpha"
                        PickerVariant="PickerVariant.Inline"
                        Variant="Variant.Text"
                        Underline="false"
                        Margin="Margin.None"/>
    </div>
</DtField>

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter] public MudColor? Value { get; set; }

    [Parameter] public EventCallback<MudColor> ValueChanged { get; set; }

    [Parameter] public bool ShowAlpha { get; set; }

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Class { get; set; }
}

@using System.Globalization

@* The supported cultures in the shared select; only the values differ from an enum's. *@

<DtSelect TValue="CultureInfo"
          Label="@Label"
          Value="@Context.Localization.CurrentCulture"
          ValueChanged="@OnCultureChangedAsync"
          Items="@_cultures"
          ItemToDisplay="@(culture => Context.Localization.GetLocal(culture))"
          Class="@Class"/>

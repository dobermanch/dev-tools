@*
    One read-only result: a mono microlabel over the same box an editable field uses, with the copy
    action inside it.
*@

<div class="dt-field-value @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="dt-label-mono dt-label-mono-sm">@Label</span>
    }

    <div class="dt-box dt-box-readonly">
        <span class="dt-box-value">@Value</span>
        <DtCopyButton Text="@Value" />
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Value { get; set; }

    [Parameter] public string? Class { get; set; }
}

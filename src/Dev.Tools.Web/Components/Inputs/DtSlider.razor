@typeparam T

<DtField Label="@LabelWithValue" For="@_id" Hint="@Hint" Class="@Class">
    <div class="dt-slider-wrap">
        <input id="@_id"
               class="dt-slider dt-focus-ring"
               type="range"
               min="@MinValue"
               max="@MaxValue"
               step="@Step"
               value="@_displayValue"
               @oninput="OnInput"
               @onchange="OnChangedAsync" />
    </div>
</DtField>

@*
    Where a tool's result comes out. Either a block of text or whatever the page puts inside - labelled
    fields, an SVG, a diff - with copy, download, and a refresh for the tools that generate.
*@

<DtPane Label="@Label" Accent="true" Class="@Class">
    <Actions>
        @if (OnRefresh.HasDelegate)
        {
            <DtIconButton Icon="@Icons.Material.Outlined.Refresh"
                          Size="DtControlSize.Small"
                          Tooltip="@_localizer["Button.Refresh.Tooltip"]"
                          OnClick="@OnRefresh"/>
        }

        <DtCopyButton Text="@Text" />

        <DtIconButton Icon="@Icons.Material.Outlined.Download"
                      Size="DtControlSize.Small"
                      Disabled="@string.IsNullOrEmpty(Text)"
                      Tooltip="@_localizer["Button.Download.Tooltip"]"
                      OnClick="@DownloadAsync"/>
    </Actions>

    <ChildContent>
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <pre class="dt-pane-output" style="min-height: @(MinHeight)px">@Text</pre>
        }
    </ChildContent>

    <Footer>
        <span class="@(StatusIsError ? "dt-pane-status-error" : "dt-pane-status")">
            @(Status ?? _localizer["Text.Ok"])
        </span>
    </Footer>
</DtPane>

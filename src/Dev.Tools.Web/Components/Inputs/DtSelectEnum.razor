@typeparam T

@* An enum's members in the shared select; the label comes from the tool's own translations. *@

<DtSelect TValue="T"
          Label="@Label"
          Value="@Value"
          ValueChanged="@ValueChanged"
          Items="@EnumValues"
          ItemToDisplay="@Display"
          Hint="@Hint"
          Error="@Error"
          ErrorText="@ErrorText"
          Class="@Class"/>

@if (SingleLine)
{
    <div class="@DivMarker @Class" style="display: flex; align-items: center; gap: 6px; width: 100%; max-width: 100%; overflow: hidden;">
        @foreach (var keyword in _visibleKeywords)
        {
            <DtTag Truncate="true" Text="@Context.Localization.GetKeyword(keyword)" />
        }

        @if (_hiddenKeywords.Any())
        {
            <MudTooltip>
                <ChildContent>
                    <DtTag Accent="true" Text="@($"+{_hiddenKeywords.Count}")" />
                </ChildContent>
                <TooltipContent>
                    <div style="max-width: 300px; display: flex; flex-wrap: wrap; gap: 4px;">
                        @foreach (var keyword in _hiddenKeywords)
                        {
                            <DtTag Text="@Context.Localization.GetKeyword(keyword)" />
                        }
                    </div>
                </TooltipContent>
            </MudTooltip>
        }
    </div>
}
else
{
    <div class="@Class" style="display: flex; flex-wrap: wrap; gap: 6px;">
        @foreach (var keyword in ToolDefinition.Keywords.OrderBy(it => it))
        {
            <DtTag Text="@Context.Localization.GetKeyword(keyword)" />
        }
    </div>
}

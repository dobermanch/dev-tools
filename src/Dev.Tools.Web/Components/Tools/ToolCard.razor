<div class="dt-tool-card" @onclick="NavigateToToolPage">
    <div class="dt-tool-card-head">
        <span class="dt-tool-card-icon">
            <MudIcon Icon="@ToolIconProvider.GetToolIcon(Tool)" Style="width:20px;height:20px" />
        </span>
        <span class="dt-tool-card-title">@Context.Localization.GetToolTitle(Tool)</span>
        @* Starring a tool is not opening it. *@
        <span @onclick:stopPropagation="true">
            <FavoriteButton ToolDefinition="@Tool" />
        </span>
    </div>

    <div class="dt-tool-card-slug">@Tool.Name</div>

    <div class="dt-tool-card-description">@Context.Localization.GetToolDescription(Tool)</div>

    <KeywordChips ToolDefinition="@Tool" SingleLine="true" />
</div>

@using Dev.Tools.Web.Services

<div class="dt-tool-rows @Class">
    @foreach (var tool in Tools)
    {
        <div class="dt-tool-row" @onclick="@(() => NavigateTo(tool))">
            <span class="dt-tool-row-icon">
                <DtIcon Icon="@ToolIconProvider.GetToolIcon(tool)" />
            </span>
            <span class="dt-tool-row-title">@Context.Localization.GetToolTitle(tool)</span>
            <span class="dt-tool-row-slug">@tool.Name</span>
            <span class="dt-tool-row-description">@Context.Localization.GetToolDescription(tool)</span>
            @* Starring a tool is not opening it. *@
            <span @onclick:stopPropagation="true">
                <FavoriteButton ToolDefinition="@tool" />
            </span>
        </div>
    }
</div>

@code {
    [Inject] private WebContext Context { get; set; } = null!;

    [Parameter] public IEnumerable<ToolDefinition> Tools { get; set; } = [];

    [Parameter] public string? Class { get; set; }

    private void NavigateTo(ToolDefinition tool)
    {
        Context.Navigation.NavigateTo($"tools/{tool.Name}");
    }
}

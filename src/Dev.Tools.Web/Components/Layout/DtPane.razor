@*
    The pane of the design: a mono label and its actions across the top, a body, and an optional footer.
    Accent marks the one a tool's result comes out of.
*@

<section class="dt-pane @(Accent ? "dt-pane-accent" : null) @Class">
    <header class="dt-pane-header">
        <span class="dt-label-mono dt-pane-label">@Label</span>
        @Actions
    </header>

    <div class="dt-pane-body">
        @ChildContent
    </div>

    @if (Footer is not null)
    {
        <footer class="dt-pane-footer">
            @Footer
        </footer>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = null!;

    /// <summary>The output pane: accent border and label.</summary>
    [Parameter] public bool Accent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public string? Class { get; set; }
}

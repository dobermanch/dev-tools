@*
    The head of a page that is not a tool - Settings, Not found. The tool pages have their own header,
    which adds the breadcrumb, the icon and the per-tool actions.
*@

<header class="dt-page-header">
    <h1 class="dt-page-title">@Caption</h1>

    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="dt-page-description">@Description</p>
    }

    @if (Actions is not null)
    {
        <div class="dt-page-header-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public required string Caption { get; set; }

    [Parameter] public string? Description { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
}

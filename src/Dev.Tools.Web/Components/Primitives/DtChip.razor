@*
    A filter pill: the index's categories, and the "all" that clears them.
*@

<button type="button"
        class="dt-chip dt-focus-ring @(Selected ? "dt-chip-selected" : null) @Class"
        aria-pressed="@(Selected ? "true" : "false")"
        @onclick="OnClick">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <DtIcon Icon="@Icon" Size="DtControlSize.Small" />
    }
    @Text
    @if (!string.IsNullOrEmpty(Count))
    {
        <span class="dt-chip-count">@Count</span>
    }
</button>

@code {
    [Parameter] public string? Text { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public string? Count { get; set; }

    [Parameter] public bool Selected { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public string? Class { get; set; }
}

@*
    The mono microlabel. The recipe itself is .dt-label-mono in app.css, shared with the labels that
    components draw inside their own markup; this is the standalone form.
*@

<span class="dt-label-mono @(Section ? "dt-label-mono-section" : null) dt-mono-label @Class">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }

    @if (!string.IsNullOrEmpty(Count))
    {
        <span class="dt-mono-label-count">@Count</span>
    }
</span>

@code {
    [Parameter] public string? Text { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Heading a section, with the wider tracking that goes with it.</summary>
    [Parameter] public bool Section { get; set; }

    /// <summary>Shown after the label in a fainter tone, not uppercased.</summary>
    [Parameter] public string? Count { get; set; }

    [Parameter] public string? Class { get; set; }
}

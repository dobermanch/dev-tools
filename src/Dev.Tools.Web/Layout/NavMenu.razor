@using Dev.Tools.Web.Services

<nav class="dt-nav @(Collapsed ? "dt-nav-rail" : null)">
    <div class="dt-nav-group">
        @if (!Collapsed)
        {
            <span class="dt-nav-group-label">@_localizer["Group.Navigate"]</span>
        }

        <a class="dt-nav-row @(IsAllToolsActive ? "dt-nav-row-active" : null)"
           href="./"
           title="@_localizer["AllTools"]">
            <span class="dt-nav-icon">
                <MudIcon Icon="@Icons.Material.Outlined.GridView" Style="width:18px;height:18px" />
            </span>
            @if (!Collapsed)
            {
                <span class="dt-nav-text">@_localizer["AllTools"]</span>
            }
        </a>

        <a class="dt-nav-row @(IsFavoritesActive ? "dt-nav-row-active" : null)"
           href="./?view=favorites"
           title="@_localizer["Favorites"]">
            <span class="dt-nav-icon">
                <MudIcon Icon="@Icons.Material.Outlined.StarBorder" Style="width:18px;height:18px" />
            </span>
            @if (!Collapsed)
            {
                <span class="dt-nav-text">@_localizer["Favorites"]</span>
                <span class="dt-nav-count">@_favoriteCount</span>
            }
        </a>

        <a class="dt-nav-row @(IsRecentActive ? "dt-nav-row-active" : null)"
           href="./?view=recent"
           title="@_localizer["Recent"]">
            <span class="dt-nav-icon">
                <MudIcon Icon="@Icons.Material.Outlined.History" Style="width:18px;height:18px" />
            </span>
            @if (!Collapsed)
            {
                <span class="dt-nav-text">@_localizer["Recent"]</span>
                <span class="dt-nav-count">@_recentCount</span>
            }
        </a>
    </div>

    <div class="dt-nav-group">
        @if (!Collapsed)
        {
            <span class="dt-nav-group-label">@_localizer["Group.Categories"]</span>
        }

        @foreach (var category in _categories)
        {
            var name = Context.Localization.GetCategory(category);
            <a class="dt-nav-row @(_activeCategory == category ? "dt-nav-row-active" : null)"
               href="@($"./?category={category}")"
               title="@name">
                <span class="dt-nav-icon">
                    <MudIcon Icon="@ToolIconProvider.GetCategoryIcon(category)" Style="width:18px;height:18px" />
                </span>
                @if (!Collapsed)
                {
                    <span class="dt-nav-text">@name</span>
                    <span class="dt-nav-count">@CountFor(category)</span>
                }
            </a>
        }
    </div>

    @if (!Collapsed)
    {
        <div class="dt-nav-footer">
            <span class="dt-nav-footer-title">@_localizer["RunsLocally.Title"]</span>
            <span class="dt-nav-footer-text">@_localizer["RunsLocally.Text"]</span>
        </div>
    }
</nav>

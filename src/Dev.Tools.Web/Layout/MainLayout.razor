@using System.Globalization
@using Dev.Tools.Web.Theme
@inherits LayoutComponentBase
@implements IAsyncDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@DevToolsTheme.Theme" IsDarkMode="@IsDarkMode" ObserveSystemThemeChange="@ObserveSystemThemeChange" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout @key="CultureInfo.CurrentUICulture.Name">
    <MudAppBar Elevation="0" Dense="true" Class="dt-appbar">
        <MudIconButton
            Icon="@Icons.Material.Outlined.Menu"
            Size="Size.Medium"
            Variant="Variant.Text"
            DropShadow="false"
            Edge="Edge.Start"
            OnClick="@DrawerToggle"/>

        <a href="./" class="dt-brand">
            <img src="logo.svg" width="30" height="30" alt="" />
            <span class="dt-brand-lines">
                <span class="dt-wordmark">DEV.TOOLS</span>
                <span class="dt-brand-sub">@BrandLine</span>
            </span>
        </a>

        <MudSpacer />

        <button type="button" class="dt-search-button" @onclick="@OpenSearchDialogAsync">
            <DtIcon Icon="@Icons.Material.Outlined.Search" Size="DtControlSize.Small" />
            <span class="dt-search-label">@_localizer["Button.Search.Label"]</span>
            <span class="dt-kbd">@ShortcutLabel</span>
        </button>

        <span class="dt-appbar-actions">
            <DtIconButton Icon="@LightModeIcon"
                          Size="DtControlSize.Large"
                          Tooltip="@_localizer["Button.Theme.Tooltip"]"
                          OnClick="@ChangeThemeModeAsync"/>

            <DtIconButton Icon="@Icons.Material.Outlined.Settings"
                          Size="DtControlSize.Large"
                          Tooltip="@_localizer["Button.Settings.Tooltip"]"
                          OnClick="@(() => Context.Navigation.NavigateTo("settings"))"/>

            <a class="dt-appbar-link"
               href="https://github.com/dobermanch/dev-tools"
               target="_blank"
               rel="noreferrer"
               title="@_localizer["Button.Repository.Tooltip"]"
               aria-label="@_localizer["Button.Repository.Tooltip"]">
                <DtIcon Icon="@Icons.Custom.Brands.GitHub" Size="DtControlSize.Large" />
            </a>
        </span>
    </MudAppBar>

    @* Mini: the hamburger collapses the panel to a 64px rail rather than hiding it, and below Md the
       same state opens it as a temporary drawer. IsDrawerOpen already persists, so the rail does too.
       The wordmark and the version live in the app bar now, so the panel starts at NAVIGATE. *@
    <MudDrawer Elevation="0"
               Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Never"
               Variant="DrawerVariant.Mini"
               MiniWidth="64px"
               Width="236px"
               Open="@IsDrawerOpen"
               Class="dt-drawer">
        <NavMenu Collapsed="@(!IsDrawerOpen)"/>
    </MudDrawer>

    <MudMainContent>
        <div class="dt-main">
            @Body
        </div>
    </MudMainContent>
</MudLayout>
